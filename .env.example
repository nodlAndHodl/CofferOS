# CofferOS environment configuration.
# Copy to `.env` and adjust. All values are optional and have sane defaults.

# Port the web interface is exposed on (http://localhost:<port>).
COFFEROS_PORT=8080

# --- Bitcoin Core integration (optional, watch-only) -------------------------
# CofferOS runs fine with no node. Enable to show live chain status.
BITCOIN_CORE_ENABLED=false
BITCOIN_CORE_RPC_URL=http://127.0.0.1:8332
BITCOIN_CORE_RPC_USER=
BITCOIN_CORE_RPC_PASSWORD=
# Optional wallet name for wallet-scoped RPC calls.
BITCOIN_CORE_WALLET=
# Optional SOCKS5 proxy for .onion/Tor RPC (e.g. tor:9051 when using the compose tor sidecar).
BITCOIN_CORE_SOCKS5_PROXY=

# --- Electrum server integration (optional) ----------------------------------
# Used as an alternative IUtxoProvider for wallet rescans. Enable to avoid
# scantxoutset against Bitcoin Core.
ELECTRUM_ENABLED=false
ELECTRUM_HOST=your-electrum.onion
ELECTRUM_PORT=50001
ELECTRUM_NETWORK=Mainnet
ELECTRUM_SOCKS5_PROXY=tor:9051
ELECTRUM_ADDRESS_SCAN_COUNT=100
ELECTRUM_BATCH_SIZE=100
ELECTRUM_TIMEOUT_SECONDS=60

# --- Bitcoin Price Engine ----------------------------------------------------
# Controls automatic BTC price fetching for loans, treasury, and dashboard.
# Provider options: "manual" | "coingecko" | "coinbase"
BITCOIN_PRICE_ENABLED=true
BITCOIN_PRICE_PRIVACY_MODE=false
BITCOIN_PRICE_POLL_INTERVAL_SECONDS=300
BITCOIN_PRICE_PROVIDER=manual

