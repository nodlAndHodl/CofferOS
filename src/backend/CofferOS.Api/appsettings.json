{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=data/cofferos.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "Integrations": {

  "BitcoinPrice": {
    "Enabled": true,
    "PrivacyMode": false,
    "PollIntervalSeconds": 300,
    "Provider": "coingecko"
  },
    "BitcoinCore": {
      "Enabled": false,
      "RpcUrl": "http://127.0.0.1:8332",
      "RpcUser": "",
      "RpcPassword": "",
      "WalletName": "",
      "TimeoutSeconds": 30,
      "Socks5Proxy": "127.0.0.1:9051"
    },
    "ElectrumServer": {
      "Enabled": true,
      "Host": "local.onion",
      "Port": 50001,
      "Network": "Mainnet",
      "Socks5Proxy": "127.0.0.1:9051",
      "AddressScanCount": 1000,
      "BatchSize": 100,
      "TimeoutSeconds": 120
    }
  },
  
  "AllowedHosts": "*"
}
