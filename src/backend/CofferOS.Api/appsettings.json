{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=data/cofferos.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "Integrations": {
    "BitcoinCore": {
      "Enabled": false,
      "RpcUrl": "http://127.0.0.1:8332",
      "RpcUser": "",
      "RpcPassword": "",
      "WalletName": "",
      "TimeoutSeconds": 30
    }
  },
  "BitcoinPrice": {
    "Enabled": true,
    "PrivacyMode": false,
    "PollIntervalSeconds": 300,
    "Provider": "manual"
  },
  "AllowedHosts": "*"
}
